{
	"name": "prmsq",
	"version": "0.1.0",
	"description": "Promise queue: throttle promise-returning functions with a call interval and a pending limit.",
	"type": "module",
	"main": "./src/index.js",
	"types": "./src/index.d.ts",
	"exports": {
		".": {
			"types": "./src/index.d.ts",
			"default": "./src/index.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"src/index.js",
		"src/index.d.ts"
	],
	"sideEffects": false,
	"engines": {
		"node": ">=20.19"
	},
	"scripts": {
		"test": "node --test",
		"test:types": "tsc -p tsconfig.json",
		"coverage": "node --test --experimental-test-coverage test/queue.test.js",
		"check": "npm run test:types && npm test",
		"example": "node examples/throttle.js",
		"prepublishOnly": "npm run check"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/webduvet/prmsq.git"
	},
	"keywords": [
		"promise",
		"queue",
		"rate-limit",
		"throttle",
		"concurrency",
		"typescript"
	],
	"author": "Andrej Bartko",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/webduvet/prmsq/issues"
	},
	"homepage": "https://github.com/webduvet/prmsq#readme",
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"dependencies": {
		"deferable": "^1.0.0"
	},
	"devDependencies": {
		"typescript": "^5.9.0"
	}
}
